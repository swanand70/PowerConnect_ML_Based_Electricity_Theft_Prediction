# Application Environment Configuration Example
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://theft_admin:YOUR_SECURE_PASSWORD@localhost:3306/electricity_theft_db?charset=utf8mb4
DB_HOST=localhost
DB_PORT=3306
DB_NAME=electricity_theft_db
DB_USER=theft_admin
DB_PASSWORD=YOUR_SECURE_PASSWORD

# Security
JWT_SECRET_KEY=YOUR_RANDOMLY_GENERATED_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000

# Machine Learning Paths
MODEL_DIR=models/v1
ACTIVE_MODEL_VERSION=v1.0.0
